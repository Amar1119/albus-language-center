# Энэ файлыг .env нэрээр хуулж, утгуудаа бөглөнө:  cp .env.example .env

# Админ самбарын нууц үг (заавал, 10+ тэмдэгт)
ADMIN_PASSWORD=

# Серверийн порт
PORT=3000

# production орчинд: production (Secure cookie, нууц үг заавал)
NODE_ENV=production

# Nginx/Cloudflare-ийн ард ажиллаж байвал 1 (жинхэнэ IP-г X-Forwarded-For-оос авна)
TRUST_PROXY=1

# Өгөгдлийн сангийн байршил (анхдагч: data/albus.db)
# DB_PATH=/var/lib/albus/albus.db

# Админ хэдэн цаг идэвхгүй байвал гаргах вэ (анхдагч: 12)
# SESSION_HOURS=12

# (Заавал биш) Шинэ бүртгэл ирэхэд Telegram-аар мэдэгдэл авах
# TELEGRAM_BOT_TOKEN=123456:ABC...
# TELEGRAM_CHAT_ID=123456789
